# Copy to .env for `alchemy dev` and `alchemy deploy`. In CI, set these as secrets.

# Sender of sign-in links. Its domain must be onboarded to Cloudflare Email
# Service; set EMAIL_ZONE_ID to let Alchemy onboard it for you.
EMAIL_FROM=signin@example.com
# EMAIL_ZONE_ID=

# Encrypts users' OpenRouter keys at rest. Generate once with
# `openssl rand -base64 32`, store it safely, and never change it: stored keys
# can't be decrypted without it.
KEY_ENCRYPTION_SECRET=
