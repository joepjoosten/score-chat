# Copy to .env for `alchemy dev` and `alchemy deploy`. In CI, set these as
# secrets and variables.

# Encrypts users' OpenRouter keys at rest. Generate once with
# `openssl rand -base64 32`, store it safely, and never change it: stored keys
# can't be decrypted without it.
KEY_ENCRYPTION_SECRET=

# PDF to LilyPond: the image from `npm run converter:build`, on this machine or
# in a registry. Without it, conversion is off and the Open button takes only
# LilyPond files.
# CONVERTER_IMAGE=score-chat-converter
# A converter to call instead of the container, e.g. one run locally:
# CONVERTER_URL=http://127.0.0.1:8080

# Sign-in, option 1: Cloudflare Access (Zero Trust). No mail domain needed:
# Cloudflare emails the one-time PIN. Set your team domain; the deploy creates
# an Access application for the sign-in path only.
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# The One-time PIN identity provider's ID (Zero Trust > Settings >
# Authentication), to skip the provider picker. Optional.
# ACCESS_IDP_ID=
# The application's audience tag, printed by the deploy as accessAud. Setting
# it makes the Worker check it too. Optional.
# ACCESS_AUD=

# Sign-in, option 2: links sent from your own domain with Cloudflare Email
# Service. Used when ACCESS_TEAM_DOMAIN is empty, and always under
# `alchemy dev`, where mail is simulated.
EMAIL_FROM=signin@example.com
# With the domain on Cloudflare, Alchemy onboards it for sending.
# EMAIL_ZONE_ID=
