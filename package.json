    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@effect/ai-openrouter": "4.0.1",
    "@effect/atom-react": "4.0.1",
    "@lezer/highlight": "^1.2.5",
    "effect": "4.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
